# Environment variables
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node.js / Next.js
node_modules/
.next/
out/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Project data - raw source files (large, original/licensed data - not tracked)
data/raw/*.pdf
data/raw/*.xlsx
data/raw/*.xls

# Project data - generated OCR pipeline intermediates (large, regeneratable from data/raw/ via data/scripts/)
data/processed/page_images/
data/processed/ocr_raw/

# Python cache (already covered by __pycache__/ above, listed for clarity)
data/scripts/__pycache__/

# Reddit 원본 데이터 (작성자 유저네임 + 게시물 본문 포함) - public 레포에 올리지 않음.
# 실제 저장은 Supabase(private DB)로 이관 예정. 로컬 작업 파일만 여기 남는다.
data/raw/reddit/
data/processed/qualitative/
